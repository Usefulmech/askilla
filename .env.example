# ============================================================
#  Askilla AI Tutor — Environment Variables
#  Copy this file to .env.local and fill in your real values
# ============================================================

# ──────────────────────────────────────────────────────────────
# 1. DATABASE — PostgreSQL via Neon (Required)
# ──────────────────────────────────────────────────────────────
# Sign up at https://neon.tech and create a new project.
# Copy the connection string from the Neon dashboard.
# It should look like:
#   postgresql://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require
#
# Example:
DATABASE_URL="postgresql://askilla_user:YOUR_NEON_PASSWORD@ep-cool-sample-123456.us-east-2.aws.neon.tech/askilla?sslmode=require"

# ──────────────────────────────────────────────────────────────
# 2. OPENAI API KEY — GPT-4o Module Generation + Neural TTS (Required)
# ──────────────────────────────────────────────────────────────
# Sign up at https://platform.openai.com
# Create an API key at https://platform.openai.com/api-keys
# This key powers:
#   - GPT-4o native language module generation (/api/generate-module)
#   - OpenAI Neural Text-to-Speech engine (/api/tts)
#
# Without this key, the app falls back to offline sample modules
# and browser Web Speech API for TTS (lower quality).
#
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx"

# ──────────────────────────────────────────────────────────────
# 3. ENVIRONMENT MODE
# ──────────────────────────────────────────────────────────────
# "development" for local dev, "production" for deployment
NODE_ENV="development"

# ──────────────────────────────────────────────────────────────
# 4. NEXT.JS PUBLIC URL (Optional — for deployment)
# ──────────────────────────────────────────────────────────────
# Set this when deploying to Vercel, Railway, or any hosting.
# Used for absolute URL resolution in metadata and share links.
#
# NEXT_PUBLIC_APP_URL="https://askilla.vercel.app"

# ──────────────────────────────────────────────────────────────
# 5. DIRECT DATABASE URL (Optional — for Prisma migrations)
# ──────────────────────────────────────────────────────────────
# Neon provides a separate direct (non-pooled) connection URL
# for running Prisma migrations. Only needed if you run:
#   npx prisma migrate dev
#
# DIRECT_URL="postgresql://askilla_user:YOUR_NEON_PASSWORD@ep-cool-sample-123456.us-east-2.aws.neon.tech/askilla?sslmode=require"
